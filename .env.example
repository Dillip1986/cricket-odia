# Server port (Render/Heroku inject PORT automatically)
PORT=3000

# CricAPI key for verified live scores (free at https://www.cricapi.com).
# Free keys allow ~100 upstream hits/day — the server caches aggressively
# to stay inside budget. Without a key the app shows "no match today".
CRICAPI_KEY=

# Upstream cache for live scores in ms (default 10 min).
LIVE_CACHE_TTL_MS=600000

# Upstream cache for upcoming fixtures in ms (default 90 min).
FIXTURES_CACHE_TTL_MS=5400000

# Cooldown after an upstream failure in ms (default 10 min).
UPSTREAM_COOLDOWN_MS=600000

# Second source: Cricbuzz via RapidAPI — covers internationals, IPL,
# Ranji Trophy and women's games missing from CricAPI.
# Subscribe at https://rapidapi.com/cricketapilive/api/cricbuzz-cricket
CRICBUZZ_KEY=
# Rarely needs changing:
CRICBUZZ_HOST=cricbuzz-cricket.p.rapidapi.com
# Cricbuzz caches (default 15 min live, 120 min upcoming).
CRICBUZZ_LIVE_TTL_MS=900000
CRICBUZZ_FIX_TTL_MS=7200000
