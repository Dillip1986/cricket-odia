# Server port (Render/Heroku inject PORT automatically)
PORT=3000

# Second source: Cricbuzz via RapidAPI — extra internationals, leagues,
# women's games. Subscribe at https://rapidapi.com/cricketapilive/api/cricbuzz-cricket
CRICBUZZ_KEY=
# Rarely needs changing:
CRICBUZZ_HOST=cricbuzz-cricket.p.rapidapi.com
# Cricbuzz caches (default 15 min live, 120 min upcoming).
CRICBUZZ_LIVE_TTL_MS=900000
CRICBUZZ_FIX_TTL_MS=7200000

# Source C needs no key: ESPNcricinfo's live page (same list as cricinfo.com).
# Set ESPN_ENABLED=false to disable it.
ESPN_ENABLED=true
# ESPN page cache in ms (default 3 min — keyless, so result flips stay fresh).
ESPN_TTL_MS=180000

# Upstream cache for the merged live payload in ms (default 5 min).
LIVE_CACHE_TTL_MS=300000

# Cooldown after an upstream failure in ms (default 10 min).
UPSTREAM_COOLDOWN_MS=600000

# Admin console gate. The PIN lives ONLY here / in host env vars —
# it is never bundled into the app and never displayed.
# Leave empty to disable the admin console entirely.
ADMIN_PIN=
